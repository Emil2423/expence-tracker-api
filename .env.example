# Django Settings
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production-use-python-c-import-secrets-print-secrets-token-urlsafe-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration (PostgreSQL for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=finance_tracker_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# For SQLite (development only)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# CORS Configuration (add your frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourfrontend.com

# Logging
DJANGO_LOG_LEVEL=INFO
